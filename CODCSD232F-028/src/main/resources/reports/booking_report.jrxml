<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="booking_report"
              pageWidth="595"
              pageHeight="842"
              columnWidth="555"
              leftMargin="20"
              rightMargin="20"
              topMargin="20"
              bottomMargin="20">

    <queryString>
        <![CDATA[
        SELECT
            b.id AS booking_id,
            g.name AS guest_name,
            r.room_number,
            b.check_in_date,
            b.check_out_date,
            b.total_amount
        FROM bookings b
        JOIN guests g ON b.guest_id = g.id
        JOIN rooms r ON b.room_id = r.id
        ORDER BY b.check_in_date DESC
        ]]>
    </queryString>

    <field name="booking_id" class="java.lang.Integer"/>
    <field name="guest_name" class="java.lang.String"/>
    <field name="room_number" class="java.lang.String"/>
    <field name="check_in_date" class="java.sql.Date"/>
    <field name="check_out_date" class="java.sql.Date"/>
    <field name="total_amount" class="java.math.BigDecimal"/>

    <title>
        <band height="50">
            <staticText>
                <reportElement x="0" y="0" width="555" height="30"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="18" isBold="true"/>
                </textElement>
                <text><![CDATA[Hotel Management - Booking Revenue Report]]></text>
            </staticText>
        </band>
    </title>

    <columnHeader>
        <band height="30">

            <staticText>
                <reportElement x="0" y="0" width="80" height="20"/>
                <textElement>
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Booking ID]]></text>
            </staticText>

            <staticText>
                <reportElement x="80" y="0" width="120" height="20"/>
                <textElement>
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Guest Name]]></text>
            </staticText>

            <staticText>
                <reportElement x="200" y="0" width="80" height="20"/>
                <textElement>
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Room No]]></text>
            </staticText>

            <staticText>
                <reportElement x="280" y="0" width="90" height="20"/>
                <textElement>
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Check-In]]></text>
            </staticText>

            <staticText>
                <reportElement x="370" y="0" width="90" height="20"/>
                <textElement>
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Check-Out]]></text>
            </staticText>

            <staticText>
                <reportElement x="460" y="0" width="95" height="20"/>
                <textElement>
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Total Amount]]></text>
            </staticText>

        </band>
    </columnHeader>

    <detail>
        <band height="25">

            <textField>
                <reportElement x="0" y="0" width="80" height="20"/>
                <textFieldExpression><![CDATA[$F{booking_id}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="80" y="0" width="120" height="20"/>
                <textFieldExpression><![CDATA[$F{guest_name}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="200" y="0" width="80" height="20"/>
                <textFieldExpression><![CDATA[$F{room_number}]]></textFieldExpression>
            </textField>

            <textField pattern="yyyy-MM-dd">
                <reportElement x="280" y="0" width="90" height="20"/>
                <textFieldExpression><![CDATA[$F{check_in_date}]]></textFieldExpression>
            </textField>

            <textField pattern="yyyy-MM-dd">
                <reportElement x="370" y="0" width="90" height="20"/>
                <textFieldExpression><![CDATA[$F{check_out_date}]]></textFieldExpression>
            </textField>

            <textField pattern="¤ #,##0.00">
                <reportElement x="460" y="0" width="95" height="20"/>
                <textFieldExpression><![CDATA[$F{total_amount}]]></textFieldExpression>
            </textField>

        </band>
    </detail>

</jasperReport>